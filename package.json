{
  "name": "open-vent-sim",
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "npm run build && node server/ovs-server.mjs",
    "desktop": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "test": "vitest run && node --test tests/server.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit -p .",
    "screenshots": "npm run build && node scripts/screenshots.mjs && LANG_SHOTS=en node scripts/screenshots.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^2.1.8"
  },
  "productName": "Open Vent Sim",
  "description": "Open-source mechanical ventilation and anesthesia machine simulator, with classroom instructor console over the local network.",
  "author": "Federico Lorenzo Barra",
  "license": "MIT",
  "homepage": "https://github.com/fedebarra/open-vent-sim",
  "main": "electron/main.mjs",
  "build": {
    "appId": "it.uniupo.openventsim",
    "productName": "Open Vent Sim",
    "copyright": "MIT License \u2013 Federico Lorenzo Barra",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "dmg": {
      "title": "Open Vent Sim ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Open Vent Sim"
    },
    "portable": {
      "artifactName": "OpenVentSim-${version}-portable.exe"
    },
    "artifactName": "OpenVentSim-${version}-${os}-${arch}.${ext}"
  }
}
